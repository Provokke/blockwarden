{
  "name": "@blockwarden/relayer-client",
  "version": "0.2.0",
  "description": "Typed client for the Blockwarden relayer API, and webhook verification",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/blockwarden.git",
    "directory": "packages/relayer-client"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "viem": "2.56.7"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  }
}
