    "@aws-lambda-powertools/metrics": "2.35.0",
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/client-lambda": "3.1131.0",
    "@aws-sdk/client-sesv2": "3.1131.0",
    "@aws-sdk/client-sqs": "3.1131.0",
    "@aws-sdk/client-ssm": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@blockwarden/core": "workspace:*",
    "@blockwarden/dynamo": "workspace:*",
    "@blockwarden/relayer-client": "workspace:*",
    "viem": "2.56.3",
    "zod": "4.6.2"
